# Deployment Phase (consumer, banking, helpline)
DEPLOYMENT_PHASE=consumer

# Database
DATABASE_URL=sqlite:///./vovera.db
# DATABASE_URL=postgresql://vovera:voverapass@postgres:5432/voveradb

# Security
SECRET_KEY=generate_a_secure_random_key_here
# Fernet key (generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=N0Y4X2s1djhrOVRyU1l4dThhOF85M1J3Z280SGRDZm8=

# Redis (optional for rate limiting)
REDIS_URL=redis://localhost:6379/0

# APIs
GOOGLE_TRANSLATION_API_KEY=your_api_key_here

# Mobile Environment Variables (Prefix with EXPO_PUBLIC_)
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_ENVIRONMENT=development
